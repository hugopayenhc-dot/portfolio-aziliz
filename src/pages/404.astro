---
// Page affichée quand une adresse n'existe pas.
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { UI } from '../data/structure.js';
---
<Base title="Page introuvable">
  <section class="notfound">
    <h1 class="notfound__code">404</h1>
    <p class="notfound__text"><T t={UI.notFound} /></p>
    <a class="notfound__link" href="/"><T t={UI.backHome} /></a>
  </section>
</Base>
