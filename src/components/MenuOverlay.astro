---
// Menu plein écran : les 6 rubriques en très grands titres fins.
// - Ordinateur : survoler une rubrique affiche à droite sa photo et ses sous-rubriques.
// - Téléphone : les sous-rubriques s'ouvrent en accordéon (bouton +).
import { Image } from 'astro:assets';
import T from './T.astro';
import LangSwitch from './LangSwitch.astro';
import { UI, categoryUrl } from '../data/structure.js';
import { subLabel, instagramUrl } from '../lib/content.js';
const { categories, settings } = Astro.props;
---
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <!-- Fond : noir + lueur brun-rouge qui dérive -->
  <div class="menu__bg" aria-hidden="true">
    <div class="menu__glow"></div>
  </div>
  <!-- Bande dorée qui traverse l'écran à l'ouverture -->
  <div class="menu__wipe" aria-hidden="true"></div>

  <div class="menu__inner">
    <nav class="menu__nav" aria-label="Rubriques">
      <ol>
        {categories.map((cat, i) => (
          <li class="menu__item" style={`--i:${i}`} data-cat={cat.id}>
            <div class="menu__row">
              <a class="menu__title" href={categoryUrl(cat.id)}>
                <T fr={cat.name} en={cat.name_en} it={cat.name_it} />
              </a>
              {cat.subs.length > 0 && (
                <button class="menu__acc" type="button" aria-expanded="false" aria-controls={`menu-subs-${cat.id}`}>
                  <span aria-hidden="true">+</span>
                  <span class="visually-hidden">Sous-rubriques : {cat.name}</span>
                </button>
              )}
            </div>
            {cat.subs.length > 0 && (
              <ul class="menu__subs" id={`menu-subs-${cat.id}`} hidden>
                {cat.subs.map((s) => (
                  <li><a href={`${categoryUrl(cat.id)}#${s}`}><T t={subLabel(s)} /></a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Aperçu à droite (ordinateur seulement) -->
    <div class="menu__preview">
      {categories.map((cat) => (
        <div class="menu__preview-item" data-preview={cat.id} hidden>
          {cat.cover ? (
            <Image src={cat.cover} alt={cat.cover_alt || cat.name} widths={[480, 800]} sizes="40vw" loading="lazy" />
          ) : (
            <div class="kraft kraft--preview" aria-hidden="true"></div>
          )}
          {cat.subs.length > 0 && (
            <ul class="menu__preview-subs">
              {cat.subs.map((s) => (
                <li><a href={`${categoryUrl(cat.id)}#${s}`}><T t={subLabel(s)} /></a></li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="menu__foot">
    {settings.instagram && <a href={instagramUrl(settings.instagram)} rel="me noopener" target="_blank">Instagram</a>}
    {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
    <LangSwitch />
  </div>
</div>

<script>
  import '../scripts/menu.js';
</script>
